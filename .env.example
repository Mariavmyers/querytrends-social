# Copy this file to ".env" and fill in your own values.
# The .env file stays on your computer — it is never uploaded to GitHub.

# Required to post for real. Get it at my.blotato.com → Settings → API.
# Leave empty to use DRY RUN mode (shows what would be sent, posts nothing).
BLOTATO_API_KEY=

# Optional: makes posts sound more natural using Claude (costs a few cents per batch).
# Get it at console.anthropic.com. Leave empty to skip.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: a long random password that n8n uses to call /api/run.
# Leave empty to turn that endpoint off.
RUN_TOKEN=

PORT=3000
